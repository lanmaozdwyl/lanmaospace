/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: frame-ancestors 'self'; object-src 'none'; base-uri 'self'; default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.supabase.co https://covers.openlibrary.org https://www.gutenberg.org https://gutendex.com; font-src 'self' data:; connect-src 'self' blob: data: https://*.supabase.co wss://*.supabase.co https://openlibrary.org https://covers.openlibrary.org https://gutendex.com https://www.gutenberg.org; worker-src 'self' blob:; form-action 'self' https://wpa.qq.com
  Cache-Control: no-cache

/memo-config.js
  Cache-Control: no-store

/sw.js
  Cache-Control: no-cache

# 不要在这里给 /lib/vendor/* 之类的静态资源单独加 max-age/immutable。
# Cloudflare Pages 会把所有命中的规则拼在一起而不是覆盖，实测
# GET /lib/vendor/supabase-js-2.39.0.mjs 返回的是
#   Cache-Control: no-cache, public, max-age=31536000, immutable
# 而 no-cache 要求每次回源校验，后面的 max-age 完全不生效（87af9f3 当年就是这样清掉七条
# 一年 immutable 规则的）。想真正延长缓存，必须先把 /* 那条 no-cache 挪走并逐页改成显式规则，
# 那是另一个决定；现在的代价只是一次 304 往返，边缘节点答得很快。
# 这条约束由 tests/sdk-vendor.test.mjs 兜着，别再凭直觉加回来。
